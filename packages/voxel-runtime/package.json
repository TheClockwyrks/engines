    "url": "git+https://github.com/TheClockwyrks/engines.git",
    "directory": "packages/voxel-runtime"
  },
  "type": "module",
  "description": "Framework-agnostic voxel rig posing/clip playback plus an optional three.js binding, consumed by the in-repo viewer and real games.",
