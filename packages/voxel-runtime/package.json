  },
  "peerDependencies": {
    "three": "~0.185.0"
  },
  "devDependencies": {
    "@types/three": "~0.185.0",
    "three": "~0.185.0",
    "typescript": "^6",
    "vitest": "^5"
  },
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/genyume/the-test-cabinet/_packaging/the-test-cabinet/npm/registry/"
