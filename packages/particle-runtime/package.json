{
  "name": "@clockwyrks/particle-runtime",
  "version": "1.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheClockwyrks/engines.git",
    "directory": "packages/particle-runtime"
  },
  "type": "module",
  "description": "Framework-agnostic particle-system simulator plus optional three.js and 2D-canvas bindings, consumed by the in-repo viewer and real games. The particle analogue of @clockwyrks/voxel-runtime: a system is simulated, not posed.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "default": "./dist/three/index.js"
    },
    "./canvas": {
      "types": "./dist/canvas/index.d.ts",
      "default": "./dist/canvas/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@clockwyrks/asset-contract": "0.2.1"
  },
  "peerDependencies": {
    "three": "~0.185.0"
  },
  "devDependencies": {
    "@types/three": "~0.185.0",
    "three": "~0.185.0",
    "typescript": "^6",
    "vitest": "^5"
  },
  "publishConfig": {
    "registry": "https://pkgs.dev.azure.com/genyume/the-test-cabinet/_packaging/the-test-cabinet/npm/registry/"
  }
}
